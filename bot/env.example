# Токен бота MAX — выдаёт чат-бот «Идея фикс» (или MasterBot / business.max.ru)
MAX_BOT_TOKEN=вставь_сюда
# Любой OpenAI-совместимый ИИ. Примеры:
#  OpenAI:      AI_BASE_URL=https://api.openai.com/v1          AI_MODEL=gpt-4o-mini
#  OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1       AI_MODEL=openai/gpt-4o-mini
#  Yandex/GigaChat/локальная модель — тоже через совместимый шлюз
AI_API_KEY=вставь_сюда
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Час ежедневного напоминания и смещение часового пояса (Москва = 3)
REMIND_HOUR=18
TZ_OFFSET=3
